generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  CLIENT
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      UserRole @default(CLIENT)
  createdAt DateTime @default(now())

  products   Product[]   @relation("ProductOwner")
  cartItems  CartItem[]
  savedItems SavedItem[]
  addresses  Address[]
  orders     Order[]
  salesItems OrderItem[] @relation("AdminSales")
  loginLogs  LoginLog[]
}

model Address {
  id            Int      @id @default(autoincrement())
  userId        Int
  recipientName String
  phone         String
  streetAddress String   @db.Text
  city          String
  state         String
  postalCode    String
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  role       UserRole
  loggedInAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  category    String   @default("Other")
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  quantity    Int      @default(0)
  isActive    Boolean  @default(true)
  imageUrl    String?
  adminId     Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  admin      User        @relation("ProductOwner", fields: [adminId], references: [id])
  cartItems  CartItem[]
  savedItems SavedItem[]
  orderItems OrderItem[]

  @@index([category])
}

model CartItem {
  id        Int @id @default(autoincrement())
  userId    Int
  productId Int
  quantity  Int @default(1)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model SavedItem {
  id        Int @id @default(autoincrement())
  userId    Int
  productId Int

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id                    Int         @id @default(autoincrement())
  userId                Int
  totalAmount           Decimal     @db.Decimal(10, 2)
  deliveryName          String?
  deliveryPhone         String?
  deliveryStreetAddress String?     @db.Text
  deliveryCity          String?
  deliveryState         String?
  deliveryPostalCode    String?
  acceptedAt            DateTime?
  deliveryDate          DateTime?
  status                OrderStatus @default(PENDING)
  createdAt             DateTime    @default(now())

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  adminId   Int
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  rating    Int?
  review    String? @db.Text

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  admin   User    @relation("AdminSales", fields: [adminId], references: [id])
}
